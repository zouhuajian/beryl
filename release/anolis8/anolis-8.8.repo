[beryl-anolis-8.8-baseos]
name=Beryl Anolis OS 8.8 - BaseOS
baseurl=https://mirrors.openanolis.cn/anolis/8.8/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ANOLIS

[beryl-anolis-8.8-appstream]
name=Beryl Anolis OS 8.8 - AppStream
baseurl=https://mirrors.openanolis.cn/anolis/8.8/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ANOLIS

[beryl-anolis-8.8-powertools]
name=Beryl Anolis OS 8.8 - PowerTools
baseurl=https://mirrors.openanolis.cn/anolis/8.8/PowerTools/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ANOLIS

[beryl-anolis-8.8-extras]
name=Beryl Anolis OS 8.8 - Extras
baseurl=https://mirrors.openanolis.cn/anolis/8.8/Extras/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ANOLIS
