[Unit]
Description=Beryl Worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=beryl
Group=beryl
WorkingDirectory=/var/lib/beryl
StateDirectory=beryl
StateDirectoryMode=0750
LogsDirectory=beryl
LogsDirectoryMode=0750

ExecStartPre=/opt/beryl/bin/beryl --conf-dir /etc/beryl validate-conf worker
ExecStart=/opt/beryl/bin/beryl --conf-dir /etc/beryl worker

Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60s
SendSIGKILL=yes

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beryl
ReadWritePaths=/var/log/beryl

StandardOutput=append:/var/log/beryl/worker.log
StandardError=append:/var/log/beryl/worker.log

[Install]
WantedBy=multi-user.target
